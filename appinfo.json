{
    "title": "PDF Viewer",
    "id": "org.webosports.app.pdf",
    "version": "2.0.0",
    "vendor": "webOS Ports",
    "type": "qml",
    "main": "qml/main.qml",
    "noWindow": true,
    "useWebEngine": false,
    "useLuneOSStyle": true,
    "icon": "icon.png",
    "splashicon": "icon-256x256.png",
    "uiRevision": "2",
    "requiredPermissions": [ "application.launcher", "appmanager.management" ],
    "mimeTypes": [
        { "mime": "application/pdf", "extension": "pdf" },
        { "mime": "application/x-pdf" }
    ],
    "keywords": [ "PDF", "PDF Viewer", "Documents", "Reader", "Adobe Reader", "Acrobat", "eBook", "Manual" ]
}
